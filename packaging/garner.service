# Example systemd unit for garner. Install the binary as
# /usr/local/bin/garner and the configuration as /etc/garner/garner.yaml.
# Create the user and the state directory with garner.sysusers and
# garner.tmpfiles from this directory:
#   cp garner.sysusers /etc/sysusers.d/garner.conf && systemd-sysusers
#   cp garner.tmpfiles /etc/tmpfiles.d/garner.conf && systemd-tmpfiles --create
# run init once as that user, which prints the admin token:
#   sudo -u garner /usr/local/bin/garner init
# then: systemctl enable --now garner
# rpm support needs createrepo_c, rpm-sign (rpmsign) and gnupg2 on PATH.

[Unit]
Description=garner repository for packages and container images
Documentation=https://github.com/avesst/garner
Wants=network-online.target
After=network-online.target

[Service]
# notify: garner reports readiness after its first publish. The descriptor
# store keeps garner's listening sockets open across restarts, so requests
# wait instead of being refused; garner opens the address from
# server.listen and replaces a stored socket when that changes.
Type=notify
FileDescriptorStoreMax=2
ExecStart=/usr/local/bin/garner serve --config /etc/garner/garner.yaml
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s

User=garner
Group=garner
StateDirectory=garner
StateDirectoryMode=0750
ConfigurationDirectory=garner
# Forge tokens: LoadCredential=forgejo:/etc/garner/forgejo.token, then
# token_file: /run/credentials/garner.service/forgejo in garner.yaml.

NoNewPrivileges=yes
RemoveIPC=yes
RestrictSUIDSGID=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
UMask=0022

[Install]
WantedBy=multi-user.target
